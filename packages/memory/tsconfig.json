{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts",
    "../memory-postgres/src/**/*.ts",
    "../../examples/memory-project/**/*.ts",
    "../../apps/service/**/*.ts",
    "../../scripts/**/*.ts"
  ]
}
